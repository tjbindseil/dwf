{
  "name": "@dwf/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "coverage:clean": "node -e \"const fs=require('node:fs');fs.rmSync('coverage',{recursive:true,force:true});fs.rmSync('.vitest-reports',{recursive:true,force:true});\"",
    "coverage:unit": "vitest run --dir test/unit --coverage --coverage.reportsDirectory=coverage/unit --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0 --reporter=blob --outputFile=.vitest-reports/unit.json",
    "coverage:integration": "vitest run --dir test/integration --coverage --coverage.reportsDirectory=coverage/integration --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0 --reporter=blob --outputFile=.vitest-reports/integration.json",
    "coverage:merge": "vitest run --mergeReports .vitest-reports --coverage --coverage.reportsDirectory=coverage/merged --coverage.thresholds.lines=60 --coverage.thresholds.functions=60 --coverage.thresholds.branches=60 --coverage.thresholds.statements=60",
    "coverage": "npm run coverage:clean && npm run coverage:unit && npm run coverage:integration && npm run coverage:merge"
  },
  "dependencies": {
    "@dwf/protocol": "0.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "image-size": "^1.2.0",
    "nanoid": "^5.1.5",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
